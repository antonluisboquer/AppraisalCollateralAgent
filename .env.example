# Required to run the agent end-to-end (OpenAIDocumentExtractor +
# the LLM-orchestrated react agent). Not required to run the test suite,
# which exercises the deterministic tool functions directly.
OPENAI_API_KEY=

# Model used by core.extraction.OpenAIDocumentExtractor. Defaults to
# gpt-4o-mini if unset. The architecture spec calls for "GPT-5 mini" --
# swap in that identifier here once available in your account/region.
APPRAISAL_TITLE_TAX_EXTRACTION_MODEL=gpt-4o-mini

# Model used by the agent's create_react_agent (a langchain init_chat_model
# identifier, e.g. "openai:gpt-4o-mini" or "anthropic:claude-...").
APPRAISAL_AGENT_MODEL=openai:gpt-4o-mini

# --- Encompass (core/encompass_client.py + core/los_client.EncompassLOSClient) ---
# Only needed to wire a real LOS client for get_property_details(); not
# required for the test suite (which uses MockLOSClient) or for extraction.
# Vendored from LG-ConstructionEncompass/encompass_client.py — confirmed
# live against Prod 2026-10-21.
TEST_ENCOMPASS_CLIENT_ID=
TEST_ENCOMPASS_CLIENT_SECRET=
TEST_ENCOMPASS_INSTANCE_ID=
TEST_ENCOMPASS_API_BASE_URL=https://api.elliemae.com

PROD_ENCOMPASS_CLIENT_ID=
PROD_ENCOMPASS_CLIENT_SECRET=
PROD_ENCOMPASS_INSTANCE_ID=
PROD_ENCOMPASS_USERNAME=
PROD_ENCOMPASS_PASSWORD=
PROD_ENCOMPASS_SUBJECT_USER_ID=
PROD_ENCOMPASS_API_BASE_URL=https://api.elliemae.com
